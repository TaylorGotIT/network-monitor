#!/bin/sh
set -e

if ! getent group network-monitor >/dev/null 2>&1; then
    addgroup --system network-monitor
fi
if ! getent passwd network-monitor >/dev/null 2>&1; then
    adduser --system --ingroup network-monitor --home /var/lib/network-monitor \
        --no-create-home --disabled-login --gecos "Network Monitor" network-monitor
fi

install -d -o network-monitor -g network-monitor -m 0750 /var/lib/network-monitor
if [ ! -e /var/lib/network-monitor/config.json ]; then
    install -o network-monitor -g network-monitor -m 0640 \
        /usr/share/network-monitor/config.json /var/lib/network-monitor/config.json
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable network-monitor.service >/dev/null 2>&1 || true
    systemctl restart network-monitor.service >/dev/null 2>&1 || true
fi

exit 0
